# ============================================================
# SENTINEL-SIGMA ENVIRONMENT CONFIGURATION (EXAMPLE)
# ============================================================
# Copy this file to .env and fill in your actual API keys

# Security
JWT_SECRET_KEY=your-secret-key-here
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================
# Database Configuration — Neon PostgreSQL
# ============================================================
# PRIMARY: Use DATABASE_URL for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
# ALTERNATIVE: Can use POSTGRES_URL if DATABASE_URL is not set
# POSTGRES_URL=postgresql://user:password@host:port/dbname

# Redis Configuration (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://host:port

# ============================================================
# Firebase Authentication — Identity & Session
# ============================================================
# RECOMMENDED: Use firebase.json file (production-safe, no env escaping)
#
# Setup:
#   1. Go to: https://console.firebase.google.com/
#   2. Select your project → Project Settings
#   3. Go to "Service Accounts" tab
#   4. Click "Generate New Private Key"
#   5. Save JSON as: backend/firebase.json
#   6. Add firebase.json to .gitignore (IMPORTANT!)
#   7. On Render: Upload firebase.json as a file or use GOOGLE_APPLICATION_CREDENTIALS
#
# The backend will automatically load from backend/firebase.json
# No environment variables needed for file-based approach

# ============================================================
# Provider API Keys (LLM, Search, etc.)
# ============================================================
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
QWEN_API_KEY=your-qwen-api-key
TAVILY_API_KEY=your-tavily-api-key
SERPER_API_KEY=your-serper-api-key
