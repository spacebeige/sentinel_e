# ============================================================
# Sentinel-E — Backend Environment (EXAMPLE / TEMPLATE)
# ============================================================
# Copy to .env for local dev. Set in Render Dashboard → Environment for production.
# NEVER commit real values. .env is gitignored.
# ============================================================

# Runtime
ENVIRONMENT=production

# CORS — set to your Vercel frontend URL
ALLOWED_ORIGINS=

# ── Database ──────────────────────────────────────────────────
# Get from Neon Console → Connection Details → Connection string (asyncpg)
DATABASE_URL=

# ── Supabase ──────────────────────────────────────────────────
# Get from Supabase Dashboard → Settings → API

# Project URL (same as REACT_APP_SUPABASE_URL)
SUPABASE_URL=

# service_role secret key — BACKEND ONLY. Never expose in frontend.
# Bypasses Row Level Security. Get from Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# JWT Secret — used to verify Supabase tokens server-side.
# Get from Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# Hidden guest fallback guard — must be false in production
# TODO: Remove deprecated Firebase auth flow after Supabase stabilization
REACT_APP_GUEST_MODE=false

# ── Provider API Keys ─────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
