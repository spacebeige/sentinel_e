# ============================================================
# SENTINEL-SIGMA ENVIRONMENT CONFIGURATION (EXAMPLE)
# ============================================================
# Copy this file to .env and fill in your actual API keys

# Security
JWT_SECRET_KEY=your-secret-key-here
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================
# Database Configuration — Neon PostgreSQL
# ============================================================
# PRIMARY: Use DATABASE_URL for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
# ALTERNATIVE: Can use POSTGRES_URL if DATABASE_URL is not set
# POSTGRES_URL=postgresql://user:password@host:port/dbname

# Redis Configuration (optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://host:port

# ============================================================
# Firebase Authentication — Identity & Session
# ============================================================
# Get service account key from Firebase Console:
#   1. Go to: https://console.firebase.google.com/
#   2. Select your project → Project Settings
#   3. Go to "Service Accounts" tab
#   4. Click "Generate New Private Key"
#   5. Copy the entire JSON contents and set FIREBASE_SERVICE_ACCOUNT_JSON
#
# Option A: Direct JSON string (recommended for Vercel/Render)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com",...}

# Option B: Path to JSON file (for local development)
# FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/serviceAccountKey.json

# ============================================================
# Provider API Keys (LLM, Search, etc.)
# ============================================================
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
QWEN_API_KEY=your-qwen-api-key
TAVILY_API_KEY=your-tavily-api-key
SERPER_API_KEY=your-serper-api-key
