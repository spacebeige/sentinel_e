# AWAAZ Environment Variables
# Copy to .env and customize for your environment

# ── Asterisk ARI ───────────────────────────────────────────────────────────
ASTERISK_HOST=127.0.0.1
ASTERISK_ARI_PORT=8088
ASTERISK_ARI_USERNAME=asterisk
ASTERISK_ARI_PASSWORD=asterisk

# ── STT API Keys (Multi-Provider Support) ──────────────────────────────────
# Groq (Primary - Whisper Large V3 with Indian accent optimization)
GROQ_API_KEY=gsk_your_api_key_here

# HuggingFace (Fallback Whisper API)
HF_API_KEY=
HF_STT_API_URL=https://api-inference.huggingface.co/models/openai/whisper-large-v3

# Bhashini (Targeted for Indian language/code-mixed context)
BHASHINI_API_KEY=
BHASHINI_API_URL=https://bhashini.gov.in/api/v1/recognize

# Sarvam (Optional: language ID + phonetic->native script transliteration)
SARVAM_API_KEY=
SARVAM_LANG_DETECT_API_URL=
SARVAM_TRANSLITERATE_API_URL=
SARVAM_TRANSLATE_API_URL=
SARVAM_ENABLE_PHONETIC=true

# Local STT Fallback
STT_CONFIDENCE_THRESHOLD=0.6

# ── TTS API Keys (Multi-Provider Support) ──────────────────────────────────
# Groq TTS (Primary - unified with STT via same API key)
# Uses: GROQ_API_KEY (same as above - no separate key needed)

# ElevenLabs TTS (Secondary fallback for premium voice quality)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku

# ── LLM API Keys ───────────────────────────────────────────────────────────
# Groq (free tier: 30 calls/min, sign up at groq.com)
GROQ_API_KEY=gsk_your_api_key_here

# Ollama (local fallback, no API key needed)
# OLLAMA_URL=http://localhost:11434

# ── SMS Provider ───────────────────────────────────────────────────────────
# Fast2SMS (optional, for sending ticket confirmation SMS)
FAST2SMS_API_KEY=

# ── Language Detection ─────────────────────────────────────────────────────
# fastText model path (auto-downloaded by preflight.sh)
FASTTEXT_MODEL_PATH=/tmp/lid.176.bin

# ── Database ───────────────────────────────────────────────────────────────
DB_PATH=awaaz.db

# ── Optional: Grafana Metrics ──────────────────────────────────────────────
# PROMETHEUS_PUSHGATEWAY=http://localhost:9091
