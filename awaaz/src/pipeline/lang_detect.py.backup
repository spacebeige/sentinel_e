"""Language detection for AWAAZ using fastText."""

import logging
import os
from typing import Tuple, Dict

logger = logging.getLogger(__name__)


class TokenLevelLangDetector:
    """detects language at token level using fastText - singleton pattern."""

    _instance = None
    _model = None

    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
        return cls._instance

    @classmethod
    def get(cls):
        """Get singleton instance."""
        return cls()

    def load(self, model_path: str = None):
        """Load fastText model (call once at startup)."""
        if self._model:
            return

        if not model_path:
            model_path = os.environ.get("FASTTEXT_MODEL_PATH", "/tmp/lid.176.bin")

        try:
            import fasttext

            logger.info(f"Loading fastText model from {model_path}")
            self._model = fasttext.load_model(model_path)
            logger.info("fastText model loaded")
        except Exception as e:
            logger.error(f"Failed to load fastText: {e}")

    def detect(self, text: str) -> Tuple[str, Dict[str, float]]:
        """
        Detect language distribution in text.

        Returns: (primary_lang, distribution_dict)
        Example: ('hi', {'hi': 0.8, 'en': 0.2})
        """
        if not self._model:
            logger.warning("Model not loaded, defaulting to Hindi")
            return ("hi", {"hi": 1.0})

        try:
            predictions = self._model.predict(text.replace("\n", " "), k=5)
            labels = predictions[0]
            scores = predictions[1]

            # Convert '__label__XX' to 'XX'
            dist = {label.replace("__label__", ""): score for label, score in zip(labels, scores)}

            primary_lang = list(dist.keys())[0] if dist else "hi"
            logger.debug(f"Language distribution: {dist}")
            return (primary_lang, dist)
        except Exception as e:
            logger.error(f"Detection error: {e}")
            return ("hi", {"hi": 1.0})

    def update_profile(self, text: str, session):
        """Update session language profile based on text."""
        if not text:
            return

        lang, dist = self.detect(text)
        session.lang = lang
        session.lang_distribution = dist

        # Determine mode: pure vs mixed
        primary_score = dist.get(lang, 0.0)
        session.lang_mode = "pure" if primary_score > 0.8 else "mixed"
