########################################
# General
########################################
.DS_Store
.vscode/
__pycache__/
dist/

########################################
# Backend (Python)
########################################
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/venv/
backend/.venv/
backend/.pytest_cache/
*.log

########################################
# Backend Secrets & Credentials — NEVER commit
########################################
backend/.env
backend/firebase.json
backend/*serviceAccount*.json
backend/*-credentials.json
backend/*-service-account*.json

########################################
# Backend User Data & Models
########################################
backend/uploads/*
!backend/uploads/.gitkeep
backend/data/vectors/*
!backend/data/vectors/.gitkeep
backend/data/knowledge_base.json
backend/models/*.gguf
backend/models/*.bin

########################################
# Frontend (Node / React)
########################################
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
node_modules/

########################################
# Frontend Environment Files — NEVER commit real keys
# Real keys live in .env.local (local) and Vercel Dashboard (production)
########################################
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

########################################
# Root-level Environment Files
########################################
.env
.env.*
!.env.example

########################################
# Supabase Local Artifacts
########################################
supabase/.branches/*
supabase/.temp/*
supabase/.env
supabase/.env.*

########################################
# Vercel
########################################
.vercel/
vercel.env
vercel.env.*

########################################
# Secrets & Sensitive Files
########################################
*.secret
*.pem
*.key
*_rsa

