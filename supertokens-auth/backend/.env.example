# Runtime
NODE_ENV=development
PORT=4000
APP_NAME=SuperTokens Auth App

# Domains
API_DOMAIN=http://localhost:4000
WEBSITE_DOMAIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
AUTH_API_BASE_PATH=/auth
AUTH_WEBSITE_BASE_PATH=/auth

# SuperTokens Core (self-hosted)
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=

# Neon PostgreSQL (app metadata and app data)
# Always use sslmode=require for Neon
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require

# OAuth provider credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
