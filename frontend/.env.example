# ============================================================
# Sentinel-E — Frontend Environment (EXAMPLE / TEMPLATE)
# ============================================================
# Copy to .env.local for local dev. Set in Vercel Dashboard for production.
# NEVER commit real values. .env.local is gitignored.
# ============================================================

# Get from Supabase Dashboard → Settings → API → Project URL
REACT_APP_SUPABASE_URL=

# Get from Supabase Dashboard → Settings → API → anon / public key
# Safe to expose in frontend (RLS enforced). Do NOT use service_role here.
REACT_APP_SUPABASE_ANON_KEY=

# Your Render backend URL (no trailing slash)
REACT_APP_API_URL=

# Hidden dev/emergency fallback — MUST be false in production
# TODO: Remove deprecated Firebase auth flow after Supabase stabilization
REACT_APP_GUEST_MODE=false
